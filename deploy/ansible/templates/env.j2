# GeekNews Monitor — managed by Ansible
RSS_FEED_URL=https://news.hada.io/rss
POLL_INTERVAL_MIN=5

RELAY_URL=http://127.0.0.1:8080/webhook/geeknews
RELAY_BIND=127.0.0.1:8080
RELAY_SHARED_SECRET={{ relay_shared_secret }}

OPENCLAW_URL=http://127.0.0.1:18789/hooks/agent
OPENCLAW_HOOK_TOKEN={{ openclaw_hook_token }}
OPENCLAW_AGENT_ID=gn-monitor

SLACK_CHANNEL_ID={{ slack_channel_id }}

LOG_FILE=/var/log/geeknews/relay.log
POLLER_SEEN_DB_PATH=/opt/geeknews/poller/seen.sqlite
RELAY_SEEN_DB_PATH=/opt/geeknews/relay/relay_seen.sqlite
